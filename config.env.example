# Copie ce fichier en "config.env" (à côté de l'exécutable) et renseigne tes clés.
# config.env est ignoré par git : ne publie jamais tes clés.

# https://console.groq.com/keys
GROQ_API_KEY=
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optionnel
# Autres modèles Groq possibles : qwen/qwen3.8-27b, openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-flash-lite-latest
OCR_LANG=fra
